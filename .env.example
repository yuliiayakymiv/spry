POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
POSTGRES_DB=meetings
# Host port for Postgres (change if 5432 is already in use)
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://meetings:meetings@db:5432/meetings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Lab 4 sign-in (used by `make deploy-auth`). The secret must never be committed or built into the frontend.
COGNITO_DOMAIN_PREFIX=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev with sign-in: put VITE_COGNITO_AUTHORITY / _CLIENT_ID / _DOMAIN in frontend/.env.local

# Lab 5 weekly report (used by `make deploy-reports`). In the SES sandbox every recipient must be verified.
REPORT_RECIPIENTS=
# Optional: send from reports@<domain> (DKIM CNAMEs). Empty = send from the first recipient.
REPORT_SENDER_DOMAIN=

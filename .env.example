POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
POSTGRES_DB=meetings
# Host port for Postgres (change if 5432 is already in use)
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://meetings:meetings@db:5432/meetings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Lab 4 sign-in (used by `make deploy-auth`). The secret must never be committed or built into the frontend.
COGNITO_DOMAIN_PREFIX=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local dev with sign-in: put VITE_COGNITO_AUTHORITY / _CLIENT_ID / _DOMAIN in frontend/.env.local

# Lab 5 weekly report. Since Lab 7 these live in infra/terraform.tfvars (Terraform); kept here
# only for infra/migrate/1-retain-and-collect.sh. In the SES sandbox every recipient must be verified.
REPORT_RECIPIENTS=
# Optional: send from reports@<domain> (DKIM CNAMEs). Empty = send from the first recipient.
REPORT_SENDER_DOMAIN=

# Lab 6 Paste an agenda: where the AWS Budgets alert goes (Lab 7: budget_email in infra/terraform.tfvars).
BUDGET_EMAIL=
# Local `make parse` / `make llm-hello` / dev: optional overrides
# PARSER_MODEL=us.amazon.nova-lite-v1:0
# Local dev against the deployed parser: put VITE_PARSER_URL in frontend/.env.local
